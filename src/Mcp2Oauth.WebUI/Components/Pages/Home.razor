@page "/"
@inject AgentClient Agent
@inject NavigationManager Navigation

<PageTitle>MCP OBO demo</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <h1>MCP agent identity + on-behalf-of</h1>
        <p class="lead">
            Sign in with your Entra ID account. The agent then calls the MCP server either
            <strong>on behalf of you</strong> (OAuth on-behalf-of) or <strong>as itself</strong>
            (client credentials), and you can see which identities the server received.
        </p>
        <a class="btn btn-primary" href="authentication/login?returnUrl=/" data-enhance-nav="false">Sign in</a>
    </NotAuthorized>

    <Authorized>
        <h1>Agent</h1>

        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
            <div class="btn-group" role="group" aria-label="How the agent authenticates to the MCP server">
                <input type="radio" class="btn-check" name="mode" id="mode-obo" autocomplete="off"
                       checked="@(mode == CallMode.OnBehalfOf)" @onchange="() => SetMode(CallMode.OnBehalfOf)" />
                <label class="btn btn-outline-primary" for="mode-obo">On behalf of me (OBO)</label>

                <input type="radio" class="btn-check" name="mode" id="mode-app" autocomplete="off"
                       checked="@(mode == CallMode.AppOnly)" @onchange="() => SetMode(CallMode.AppOnly)" />
                <label class="btn btn-outline-primary" for="mode-app">Agent only (client credentials)</label>
            </div>
            <button class="btn btn-secondary" @onclick="ProbeAsync" disabled="@busy">Probe identity</button>
        </div>

        @* Sticky under the top bar, so it stays visible however far the chat has scrolled. *@
        @if (error is not null)
        {
            <div class="alert alert-danger alert-dismissible page-error" role="alert">
                @error
                @if (signInRequired)
                {
                    <a class="ms-2" href="authentication/login?returnUrl=/" data-enhance-nav="false">Sign in again</a>
                }
                <button type="button" class="btn-close" aria-label="Close" @onclick="() => error = null"></button>
            </div>
        }

        @if (probe is not null)
        {
            <div class="row g-3 mb-4">
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header">1. Token the agent sent</div>
                        <div class="card-body">
                            <ClaimsTable Claims="probe.McpToken.Claims" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header">2. What the MCP middleware saw</div>
                        <div class="card-body">
                            @if (probe.Identity is { } id)
                            {
                                <IdentityCard Identity="id" />
                            }
                            else
                            {
                                <p class="text-danger">@probe.Error</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header">3. Tools this caller can see</div>
                        <div class="card-body">
                            <ToolList Tools="probe.AvailableTools" />
                        </div>
                    </div>
                </div>
            </div>
        }

        <h2 class="h4">Chat</h2>
        <div class="chat mb-3">
            @foreach (var entry in transcript)
            {
                <div class="chat-turn @(entry.Turn.Role == "user" ? "chat-user" : "chat-assistant") @(entry.Blocked ? "chat-blocked" : "")">
                    <div class="chat-meta">
                        @(entry.Turn.Role == "user" ? "You" : "Agent")
                        @if (entry.Mode is { } m)
                        {
                            <span class="badge text-bg-light ms-1">@(m == CallMode.OnBehalfOf ? "OBO" : "agent only")</span>
                        }
                        @if (entry.Blocked)
                        {
                            <span class="badge text-bg-warning ms-1">blocked by content filter</span>
                        }
                    </div>
                    @if (entry.Turn.Role == "user")
                    {
                        <div class="chat-text">@entry.Turn.Text</div>
                    }
                    else
                    {
                        <div class="chat-markdown">@ChatMarkdown.ToHtml(entry.Turn.Text)</div>
                    }
                    @foreach (var call in entry.ToolCalls)
                    {
                        <details class="tool-call">
                            <summary><code>@call.Name</code>(@call.Arguments)</summary>
                            <pre>@call.Result</pre>
                        </details>
                    }
                </div>
            }
            @if (busy)
            {
                <div class="text-muted fst-italic">Working…</div>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mb-2">
            @foreach (var suggestion in suggestions)
            {
                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => SendAsync(suggestion)">@suggestion</button>
            }
        </div>

        <form class="d-flex gap-2" @onsubmit="() => SendAsync(input)">
            <input class="form-control" @bind="input" placeholder="Ask the agent about your expenses…" disabled="@busy" />
            <button class="btn btn-primary" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(input))">Send</button>
        </form>
    </Authorized>
</AuthorizeView>

@code {
    private static readonly string[] suggestions =
    [
        "Who are you, and who am I?",
        "List my expenses",
        "Submit a $45 expense for a team lunch",
        "What's waiting for my approval?",
        "Show the audit log",
        "What's the service status?",
    ];

    /// <param name="Blocked">Refused by the content filter: shown, but never sent to the agent again.</param>
    private sealed record TranscriptEntry(ChatTurn Turn, CallMode? Mode, IReadOnlyList<ToolCallTrace> ToolCalls, bool Blocked = false);

    private readonly List<TranscriptEntry> transcript = [];
    private CallMode mode = CallMode.OnBehalfOf;
    private ProbeResponse? probe;
    private string? input;
    private string? error;
    private bool signInRequired;
    private bool busy;

    private async Task SetMode(CallMode newMode)
    {
        mode = newMode;
        await ProbeAsync();
    }

    private Task ProbeAsync() => RunAsync(async () => probe = await Agent.ProbeAsync(mode));

    private async Task SendAsync(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return;

        input = null;
        var turn = new TranscriptEntry(new ChatTurn("user", text), null, []);
        transcript.Add(turn);

        var history = transcript.Where(e => !e.Blocked).Select(e => e.Turn).ToList();
        await RunAsync(async () =>
        {
            var reply = await Agent.ChatAsync(new AgentChatRequest(history, mode));
            if (reply.Blocked)
                transcript[transcript.IndexOf(turn)] = turn with { Blocked = true };
            transcript.Add(new(new ChatTurn("assistant", reply.Reply), mode, reply.ToolCalls, reply.Blocked));
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        error = null;
        signInRequired = false;
        try
        {
            await action();
        }
        catch (SignInRequiredException ex)
        {
            error = ex.Message;
            signInRequired = true;
        }
        catch (Exception ex) when (ex is AgentCallException or HttpRequestException)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
